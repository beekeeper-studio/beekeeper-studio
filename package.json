{
  "name": "bks-root",
  "version": "1.0.0",
  "repository": "git@github.com:beekeeper-studio/beekeeper-studio.git",
  "author": "Matthew Rathbone <matthew.rathbone@gmail.com>",
  "license": "MIT",
  "private": true,
  "scripts": {
    "bks:build": "pnpm -F beekeeper-studio electron:build",
    "bks:dev": "pnpm -F beekeeper-studio electron:serve",
    "bks:config:build": "pnpm -F beekeeper-studio config:build",
    "lib:dev": "pnpm -F @beekeeperstudio/ui-kit lib:dev",
    "lib:build": "pnpm -F @beekeeperstudio/ui-kit build",
    "electron:build": "pnpm bks:build",
    "electron:serve": "pnpm bks:dev",
    "test:e2e": "pnpm -F beekeeper-studio test:e2e",
    "test:e2e:ci": "pnpm -F beekeeper-studio test:e2e:ci",
    "test:integration": "pnpm -F beekeeper-studio test:integration",
    "test:unit": "pnpm -F beekeeper-studio test:unit && pnpm -F ui-kit test",
    "vitest:unit": "pnpm -F beekeeper-studio vitest:unit",
    "vitest:integration": "pnpm -F beekeeper-studio vitest:integration",
    "vitest:ci": "pnpm -F beekeeper-studio vitest:ci",
    "test:ci": "pnpm -F beekeeper-studio test:ci",
    "test:codemirror": "pnpm -F beekeeper-studio test:codemirror",
    "all:lint": "pnpm -F beekeeper-studio lint",
    "postinstall": "husky install",
    "prepack": "pinst --disable",
    "postpack": "pinst --enable"
  },
  "devDependencies": {
    "husky": "8.0.3",
    "pinst": "^3.0.0",
    "beekeeper-studio": "workspace:*"
  },
  "packageManager": "pnpm@12.16.1"
}
