RELATE person:01FS9307A09CWTCKBCE42NANST -> review:01HA90M4C08CGT9R6C8Z9PMK5B -> product:01GRPEB3ER9249HAYQ0H4FEJRT CONTENT {'id': r'review:01HA90M4C08CGT9R6C8Z9PMK5B', 'in': r'person:01FS9307A09CWTCKBCE42NANST', 'out': r'product:01GRPEB3ER9249HAYQ0H4FEJRT', 'rating': 5, 'review_text': "I'm obsessed with this jacket! The grey color is perfect for my style and the fit is amazing. It's also super easy to care for - just toss it in the washing machine.", 'time': {'created_at': '2023-07-25T04:22:11Z', 'updated_at': '2023-07-24T17:19:22Z'}};
RELATE person:01GA9VNRXR89686QSKBGPKYNZA -> review:01GRFJT4M89QCR9K4CCBAN20FV -> product:01GRPEB3ER9249HAYQ0H4FEJRT CONTENT {'id': r'review:01GRFJT4M89QCR9K4CCBAN20FV', 'in': r'person:01GA9VNRXR89686QSKBGPKYNZA', 'out': r'product:01GRPEB3ER9249HAYQ0H4FEJRT', 'rating': 4, 'review_text': 'I was a bit hesitant to spend so much on a jacket, but this one has been worth every penny. The grey color is really pretty and the material is top-notch.', 'time': {'created_at': '2023-03-26T13:07:13Z', 'updated_at': '2023-06-18T16:16:36Z'}};
RELATE person:01GVQTTTJ88KXRX9SV793DWD14 -> review:01G1JHV15R8XNBQM2VBYAAXP8H -> product:01GRPEB3ER9249HAYQ0H4FEJRT CONTENT {'id': r'review:01G1JHV15R8XNBQM2VBYAAXP8H', 'in': r'person:01GVQTTTJ88KXRX9SV793DWD14', 'out': r'product:01GRPEB3ER9249HAYQ0H4FEJRT', 'rating': 5, 'review_text': "This jacket has become my new favorite thing! The grey color is gorgeous and the fit is perfect. It's also surprisingly warm for how thin it is.", 'time': {'created_at': '2022-04-08T21:44:27Z', 'updated_at': '2022-08-28T10:15:06Z'}};
