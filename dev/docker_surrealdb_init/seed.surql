RELATE person:01GS4YNR0R9PGBZEX78N6RAK4P -> review:01HX2E48VG8RHT1EZKFAA5JKCB -> product:01HDY2QTTR82XS8PADHDTPEFYA CONTENT {'id': r'review:01HX2E48VG8RHT1EZKFAA5JKCB', 'in': r'person:01GS4YNR0R9PGBZEX78N6RAK4P', 'out': r'product:01HDY2QTTR82XS8PADHDTPEFYA', 'rating': 4, 'review_text': "I was a bit skeptical about buying a sweatshirt online, but this one exceeded my expectations! The Heather Grey Pink color is so soft and cozy. I've worn it every day since I got it.", 'time': {'created_at': '2024-05-04T19:33:42Z', 'updated_at': '2024-05-04T19:33:42Z'}};
RELATE person:01GG7306808J5RVG74CWNKYYZA -> review:01G0SZT5JG98G8GK8MCRZCPNF9 -> product:01HDY2QTTR82XS8PADHDTPEFYA CONTENT {'id': r'review:01G0SZT5JG98G8GK8MCRZCPNF9', 'in': r'person:01GG7306808J5RVG74CWNKYYZA', 'out': r'product:01HDY2QTTR82XS8PADHDTPEFYA', 'rating': 5, 'review_text': "This sweatshirt is perfect for casual days or layering under jackets. The fit is great, not too tight or loose. I love the Dark Heather Grey Pink color, it's really unique.", 'time': {'created_at': '2022-11-15T12:30:55Z', 'updated_at': '2022-11-15T12:30:55Z'}};
RELATE person:01HAZM0MAG8ESRCRHNRXNF6B4K -> review:01HBQTY1X083EV9MJC52N11JQ2 -> product:01HDY2QTTR82XS8PADHDTPEFYA CONTENT {'id': r'review:01HBQTY1X083EV9MJC52N11JQ2', 'in': r'person:01HAZM0MAG8ESRCRHNRXNF6B4K', 'out': r'product:01HDY2QTTR82XS8PADHDTPEFYA', 'rating': 4, 'review_text': "I've had this sweatshirt for a few weeks now and it still looks brand new. The material is super soft and comfortable. I wish they came in more colors though.", 'time': {'created_at': '2024-01-03T21:27:21Z', 'updated_at': '2024-01-03T21:27:21Z'}};
RELATE person:01GDH5VS20934B7EHGGKKZRA69 -> review:01H8PA6VTR84VRDWA1E1CK02B5 -> product:01HDY2QTTR82XS8PADHDTPEFYA CONTENT {'id': r'review:01H8PA6VTR84VRDWA1E1CK02B5', 'in': r'person:01GDH5VS20934B7EHGGKKZRA69', 'out': r'product:01HDY2QTTR82XS8PADHDTPEFYA', 'rating': 5, 'review_text': "I was surprised by how well-made this sweatshirt is! The stitching is perfect, no loose threads or anything. It's also really warm without being too bulky.", 'time': {'created_at': '2023-05-25T02:40:47Z', 'updated_at': '2023-05-25T02:40:47Z'}};
